package instruccionAlternativa;

import java.util.Scanner;

public class Horoscopo {

	public static void main(String[] args) {
		// Pedir un dia y un mes
		// imprimimos el horoscopo de la persona
		// controlamos que el mes es correcto
		
		Scanner teclado = new Scanner(System.in);
		int dia, mes;
		System.out.print("Teclea tu dia de nacimiento: ");
		dia = teclado.nextInt();
		System.out.print("Teclea tu mes de nacimiento: ");
		mes = teclado.nextInt();
		
		if(dia>=21 && mes==3 || dia<=20 && mes==4) {
			System.out.println("Aries");
		}
	}

}
